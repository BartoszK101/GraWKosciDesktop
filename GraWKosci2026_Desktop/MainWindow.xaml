<Window x:Class="GraWKosci2026_Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gra w kości 2026"
        Height="550"
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#ED27C121">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7200CC">
            <TextBlock Text="Egzamin"
                       Foreground="White"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="10,0"/>
        </Border>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <UniformGrid Rows="1" Columns="2">

                <Button Tag="0"
                        Click="Kosc_Click"
                        Margin="10"
                        Width="75"
                        Height="75"
                        Background="Transparent"
                        BorderThickness="0">

                    <Image x:Name="obrazKosc0"
                           Source="/Obrazy/kosc0.png"
                           Width="65"
                           Height="65"
                           Stretch="Fill"/>
                </Button>

                <Button Tag="1"
                        Click="Kosc_Click"
                        Margin="10"
                        Width="75"
                        Height="75"
                        Background="Transparent"
                        BorderThickness="0">

                    <Image x:Name="obrazKosc1"
                           Source="/Obrazy/kosc0.png"
                           Width="65"
                           Height="65"
                           Stretch="Fill"/>
                </Button>

            </UniformGrid>

            <UniformGrid Rows="1" Columns="3">

                <Button Tag="2"
                        Click="Kosc_Click"
                        Margin="10"
                        Width="75"
                        Height="75"
                        Background="Transparent"
                        BorderThickness="0">

                    <Image x:Name="obrazKosc2"
                           Source="/Obrazy/kosc0.png"
                           Width="65"
                           Height="65"
                           Stretch="Fill"/>
                </Button>

                <Button Tag="3"
                        Click="Kosc_Click"
                        Margin="10"
                        Width="75"
                        Height="75"
                        Background="Transparent"
                        BorderThickness="0">

                    <Image x:Name="obrazKosc3"
                           Source="/Obrazy/kosc0.png"
                           Width="65"
                           Height="65"
                           Stretch="Fill"/>
                </Button>

                <Button Tag="4"
                        Click="Kosc_Click"
                        Margin="10"
                        Width="75"
                        Height="75"
                        Background="Transparent"
                        BorderThickness="0">

                    <Image x:Name="obrazKosc4"
                           Source="/Obrazy/kosc0.png"
                           Width="65"
                           Height="65"
                           Stretch="Fill"/>
                </Button>

            </UniformGrid>

            <Button Content="RZUT"
                    Click="Rzut_Click"
                    Width="75"
                    Height="35"
                    Margin="10"
                    Background="#ED275021"
                    Foreground="White"
                    FontWeight="Bold"/>

            <TextBlock x:Name="wynik"
                       Text="0"
                       FontSize="40"
                       Foreground="#24512A"
                       HorizontalAlignment="Center"
                       Margin="5"/>

        </StackPanel>
    </Grid>
</Window>
